{
  "name": "nation-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api": "tsx apps/api/src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write apps packages tests *.ts *.json *.yaml .github/workflows/*.yml",
    "format:check": "prettier --check apps packages tests *.ts *.json *.yaml .github/workflows/*.yml"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@supabase/supabase-js": "2.57.4",
    "fastify": "5.6.1",
    "idb": "8.0.3",
    "pg": "8.16.3",
    "pixi.js": "8.13.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.18.8",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
