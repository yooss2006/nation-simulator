{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nation-simulator",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
